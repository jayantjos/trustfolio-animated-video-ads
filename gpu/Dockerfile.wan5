# Unproven GPU inference image candidate. Never deploy a paid Pod until an
# immutable GHCR digest, provider auto-terminate and independent reaper are live.
# Base image tag is frozen into the GHCR image digest after build.
FROM pytorch/pytorch:2.6.0-cuda12.4-cudnn9-runtime
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg ca-certificates \
  && rm -rf /var/lib/apt/lists/*
WORKDIR /opt
# Official source is pinned; no mutable main branch in the container.
RUN git clone --filter=blob:none https://github.com/Wan-Video/Wan2.2.git /opt/Wan2.2 \
  && cd /opt/Wan2.2 && git checkout --detach 1ea34ff48f87168174e12956e200b1d908b1c5ff
# The official Wan2.2 source falls back to Torch SDPA when flash_attn is absent.
# GPU efficiency is UNVERIFIED until the first budget-capped inference.
RUN python -m pip install --no-cache-dir \
    "transformers>=4.49.0,<=4.51.3" \
    "tokenizers>=0.20.3" "accelerate>=1.1.1" \
    "opencv-python-headless>=4.9.0.80" "diffusers>=0.31.0" \
    "imageio[ffmpeg]" "imageio-ffmpeg" \
    "easydict" "ftfy" "dashscope" "einops>=0.7,<1" "numpy>=1.23.5,<2" \
    "Pillow>=10,<12" \
  && python -m pip check
# The first REAL GPU attempt failed at import time: "No module named einops".
# Fail this FREE OCI build if Wan imports or CLI fail; do not burn GPU on errors.
RUN cd /opt/Wan2.2 \
  && python -c "import einops; import wan; from wan.modules.vae2_1 import Wan2_1_VAE; print('WAN_DEPENDENCY_IMPORT_SMOKE=PASS')" \
  && python generate.py --help >/dev/null \
  && echo "WAN_GENERATE_IMPORT_SMOKE=PASS"
COPY scripts/wan5_gpu_worker.py /opt/trustfolio/wan5_gpu_worker.py
WORKDIR /opt/Wan2.2
ENV PYTHONUNBUFFERED=1 HF_HOME=/workspace/cache/huggingface
ENTRYPOINT ["python", "/opt/trustfolio/wan5_gpu_worker.py"]
