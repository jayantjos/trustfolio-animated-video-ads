{
  "version": 1,
  "id": "trustfolio-premium-3d-asset-provenance-v1",
  "status": "NOT_PRODUCTION_READY_ASSETS_REQUIRED",
  "source_of_visual_truth": "config/approved_premium_3d_visual_contract.json",
  "base_video_contract": {
    "fps": 24,
    "dimensions": [
      1080,
      1920
    ],
    "genuine_3d_geometry_required": true,
    "model_faithfulness": "source approved actual SKU photographic evidence and rights",
    "lighting": "photoreal-quality PBR with ambient occlusion and high-quality shadow",
    "cartoon_acting": [
      "articulated hands",
      "eyes eyebrows mouth",
      "mouth speech alignment",
      "physically plausible walk cycles",
      "acting/reaction between characters"
    ]
  },
  "asset_sources": [
    {
      "source": "Poly Haven",
      "official_url": "https://polyhaven.com",
      "license": "CC0-1.0",
      "category": "PBR materials, HDRI, scenery models",
      "commercial_use_allowed": true,
      "downloaded": false,
      "license_url": "https://polyhaven.com/license",
      "note": "Verify individual asset files/hash before storage; environment only, not fabricated branded product models."
    },
    {
      "source": "Blendkit",
      "official_url": "https://www.blendkit.com",
      "license": "CC0-1.0 or royalty-free (per asset)",
      "category": "Detailed environment, props, models",
      "commercial_use_allowed": true,
      "downloaded": false,
      "license_url": "https://www.blendkit.com/docs/licenses/",
      "note": "Asset-by-asset license receipt and non-resale compliance mandatory."
    },
    {
      "source": "Kenney",
      "official_url": "https://kenney.nl",
      "license": "CC0-1.0",
      "category": "Animation prototyping only",
      "commercial_use_allowed": true,
      "downloaded": false,
      "note": "Kenney low-poly characters DO NOT satisfy approved final CGI quality and must never be marked visually approved."
    }
  ],
  "required_asset_slots": [
    "cinematic_world_scene",
    "hdri_and_high_detail_pbr_materials",
    "five_individually_identifiable_source_product_rigs",
    "expressive_eyes_eyebrows_mouth_and_limbs",
    "category_specific_prop_effects",
    "official_licensed_trustfolio_logo",
    "approved_natural_hindi_or_hinglish_voice_models",
    "licensed_background_music_and_sfx"
  ],
  "asset_receipt_required_keys": [
    "file",
    "sha256",
    "source_url",
    "license_name",
    "license_url",
    "commercial_use_verified",
    "license_verified_at",
    "rightsholder",
    "asset_model_version",
    "pixel_or_mesh_quality_human_approved"
  ],
  "policy": {
    "no_publishing_from_lowpoly_demo": true,
    "no_claiming_3d_concept_mascot_is_real_sku": true,
    "no_retailer_image_commercial_rights_assumed": true,
    "no_unapproved_voice_clones": true,
    "no_unknown_scripts_or_binaries": true,
    "no_auto_install_of_external_repos": true,
    "do_not_commit_large_model_weights": true,
    "demo_output_must_be_watermarked": true
  },
